[Unit]
Description=Persistent OpenClaw exec/process runtime for ChatGPT Web Agent
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/axelhu/.openclaw/workspace-chatgpt-web-agent
Environment=CHATGPT_WEB_AGENT_WORKSPACE=/home/axelhu/.openclaw/workspace-chatgpt-web-agent
Environment=CHATGPT_WEB_AGENT_WORKSPACE_ONLY=false
Environment=CHATGPT_WEB_AGENT_EXEC_SECURITY=full
Environment=CHATGPT_WEB_AGENT_EXEC_ASK=off
Environment=HTTP_PROXY=http://127.0.0.1:1080
Environment=HTTPS_PROXY=http://127.0.0.1:1080
Environment=NO_PROXY=127.0.0.1,localhost
ExecStart=/usr/bin/node /home/axelhu/.openclaw/workspace-chatgpt-web-agent/projects/chatgpt-web-agent/dist/exec-runtime-cli.js
Restart=always
RestartSec=2
KillMode=control-group
TimeoutStopSec=5

[Install]
WantedBy=default.target
