[Unit]
Description=Publish local health snapshot to private ChatGPT Site
After=network-online.target openclaw-gateway.service openai-tunnel-chatgpt-web-agent.service

[Service]
Type=oneshot
EnvironmentFile=%h/.config/chatgpt-sites-status/publisher.env
ExecStart=/usr/bin/python3 /home/axelhu/.openclaw/workspace-chatgpt-web-agent/projects/chatgpt-web-agent/scripts/sites-status-publisher.py
TimeoutStartSec=60
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/axelhu/.codex
ReadOnlyPaths=/home/axelhu/.openclaw/workspace-chatgpt-web-agent
Environment=PYTHONDONTWRITEBYTECODE=1

[Install]
WantedBy=default.target
