{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "webagenttools-home": {
      "type": "stdio",
      "command": "python",
      "args": [
        "${PLUGIN_ROOT}/bridge.py"
      ],
      "env": {
        "AGENT_ACCESS_BASE_URL": "https://sites.axelhu.com/agent-access",
        "AGENT_ACCESS_PROFILE": "minimax",
        "AGENT_ACCESS_CLIENT_NAME": "minimax-code"
      },
      "cwd": "${PLUGIN_DATA}"
    }
  }
}
