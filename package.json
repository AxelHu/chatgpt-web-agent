{
  "name": "@agents/chatgpt-web-agent",
  "version": "0.1.0",
  "description": "Persistent local MCP workspace and computer tools for files, repositories, Shell/processes, services, build/test, Git/Gitea, exploration, verification, automation, and durable project records.",
  "type": "module",
  "bin": {
    "chatgpt-web-agent": "dist/cli.js",
    "chatgpt-web-agent-event": "dist/event-cli.js",
    "chatgpt-web-agent-local-event": "dist/local-chat-cli.js",
    "chatgpt-web-agent-exec-runtime": "dist/exec-runtime-cli.js",
    "chatgpt-web-agent-http": "dist/http-cli.js",
    "chatgpt-web-agent-workflow": "dist/workflow-cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "start:exec-runtime": "node dist/exec-runtime-cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "rm -rf dist && pnpm build && pnpm test",
    "smoke": "tsx scripts/mcp-smoke.ts",
    "drive:auth": "tsx scripts/google-drive-auth.ts",
    "start:http": "node dist/http-cli.js"
  },
  "engines": {
    "node": ">=22.22.3 <23 || >=24.15.0 <25 || >=25.9.0"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.2.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.2.0",
    "googleapis": "^174.0.1",
    "ipaddr.js": "2.2.0",
    "openclaw": "2026.8.2",
    "standardwebhooks": "1.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^4.1.9"
  },
  "license": "MIT"
}
