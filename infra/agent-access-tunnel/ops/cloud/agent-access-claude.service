[Unit]
Description=Claude OAuth gateway for WebAgentTools
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=agentaccess
Group=agentaccess
WorkingDirectory=/opt/agent-access-claude/current/gateway
Environment=AGENT_ACCESS_LISTEN=127.0.0.1:3251
Environment=AGENT_ACCESS_UPSTREAM=http://127.0.0.1:18792
Environment=AGENT_ACCESS_PUBLIC_BASE=https://sites.axelhu.com/agent-access-claude
Environment=AGENT_ACCESS_STATE_DIR=/var/lib/agent-access-claude
Environment=AGENT_ACCESS_PROFILES=claude
Environment=AGENT_ACCESS_OAUTH_ENABLED=true
Environment=AGENT_ACCESS_OAUTH_PROFILE=claude
Environment=AGENT_ACCESS_OAUTH_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback
Environment=AGENT_ACCESS_OAUTH_REFRESH_TTL=2592000
Environment=AGENT_ACCESS_OAUTH_CODE_TTL=120
ExecStart=/usr/bin/python3 /opt/agent-access-claude/current/gateway/agent_access_gateway.py
Restart=always
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/agent-access-claude
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
