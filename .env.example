# Directory visible to file and patch tools, and the default exec working directory.
CHATGPT_WEB_AGENT_WORKSPACE=/absolute/path/to/workspace

# Keep file tools and exec.workdir inside the workspace. Defaults to true.
# Set false only for a trusted Connector when the workspace is a default working directory,
# not a security boundary.
CHATGPT_WEB_AGENT_WORKSPACE_ONLY=true

# Comma-separated public tool allowlist.
CHATGPT_WEB_AGENT_TOOLS=read,exec,process,apply_patch

# Optional overrides. When omitted, OpenClaw runtime config is used.
# CHATGPT_WEB_AGENT_EXEC_SECURITY=allowlist
# CHATGPT_WEB_AGENT_EXEC_ASK=on-miss

# Maximum text returned by one tool call before bridge-level truncation.
CHATGPT_WEB_AGENT_MAX_OUTPUT_CHARS=100000
