# Directory visible to file and patch tools, and the default exec working directory.
CHATGPT_WEB_AGENT_WORKSPACE=/absolute/path/to/workspace

# Keep file tools and exec.workdir inside the workspace. Defaults to true.
# Set false only for a trusted Connector when the workspace is a default working directory,
# not a security boundary.
CHATGPT_WEB_AGENT_WORKSPACE_ONLY=true

# Comma-separated public tool allowlist.
CHATGPT_WEB_AGENT_TOOLS=read,exec,process,apply_patch

# Optional overrides. When omitted, OpenClaw runtime config is used.
# CHATGPT_WEB_AGENT_EXEC_SECURITY=allowlist
# CHATGPT_WEB_AGENT_EXEC_ASK=on-miss

# Maximum text returned by one tool call before bridge-level truncation.
CHATGPT_WEB_AGENT_MAX_OUTPUT_CHARS=100000

# Optional Google Drive data-plane tools. Disabled until local OAuth is configured.
# When enabled, MCP additionally exposes:
# drive_list, drive_search, drive_stat, drive_upload, drive_download, drive_export, drive_mkdir
CHATGPT_WEB_AGENT_DRIVE_ENABLED=false

# Google Desktop OAuth client JSON downloaded from Google Cloud Console.
# Defaults to <workspace>/.credentials/google-drive/credentials.json
# CHATGPT_WEB_AGENT_DRIVE_CREDENTIALS=/absolute/path/to/credentials.json

# Authorized-user token generated by `pnpm drive:auth`.
# Defaults to <workspace>/.credentials/google-drive/token.json
# CHATGPT_WEB_AGENT_DRIVE_TOKEN=/absolute/path/to/token.json

# Local staging directory used by Drive upload/download/export.
# Defaults to <workspace>/exchange
# CHATGPT_WEB_AGENT_DRIVE_LOCAL_ROOT=/absolute/path/to/exchange

# Keep Drive file transfer paths inside the staging directory. Defaults to true.
# CHATGPT_WEB_AGENT_DRIVE_LOCAL_ROOT_ONLY=true
