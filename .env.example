# Directory visible to file and patch tools, and the default exec working directory.
CHATGPT_WEB_AGENT_WORKSPACE=/absolute/path/to/workspace

# Keep file tools and exec.workdir inside the workspace. Defaults to true.
# Set false only for a trusted Connector when the workspace is a default working directory,
# not a security boundary.
CHATGPT_WEB_AGENT_WORKSPACE_ONLY=true

# Shared credential for narrow direct Gateway helper tools (Skills/Feishu).
# Prefer the file form in long-lived deployments so the token is not present in
# service command lines or checked-in Tunnel profiles. The file must be a regular
# non-symlink file with no group/other permissions on POSIX systems.
# CHATGPT_WEB_AGENT_GATEWAY_TOKEN_FILE=/absolute/path/to/gateway-token
# CHATGPT_WEB_AGENT_GATEWAY_TOKEN=...

# Comma-separated public tool allowlist.
CHATGPT_WEB_AGENT_TOOLS=read,exec,process,apply_patch,rescue_exec

# Optional overrides. When omitted, OpenClaw runtime config is used.
# CHATGPT_WEB_AGENT_EXEC_SECURITY=allowlist
# CHATGPT_WEB_AGENT_EXEC_ASK=on-miss

# exec/process are served by a long-lived local runtime over a Unix socket so
# MCP/Tunnel bridge restarts do not drop OpenClaw background sessions.
# Defaults to $XDG_RUNTIME_DIR/chatgpt-web-agent/exec.sock (or a per-user /tmp fallback).
# CHATGPT_WEB_AGENT_EXEC_RUNTIME_SOCKET=/run/user/1000/chatgpt-web-agent/exec.sock
# CHATGPT_WEB_AGENT_EXEC_RUNTIME_TIMEOUT_MS=150000

# Maximum text returned by one tool call before bridge-level truncation.
CHATGPT_WEB_AGENT_MAX_OUTPUT_CHARS=100000

# Lightweight diagnostic request ledger. Stores metadata only (tool/action/session,
# timing/result sizes/error kinds), never command bodies or tool output contents.
CHATGPT_WEB_AGENT_REQUEST_LEDGER_ENABLED=true
# Defaults to ~/.local/state/chatgpt-web-agent/request-ledger
# CHATGPT_WEB_AGENT_REQUEST_LEDGER_DIR=/absolute/path/to/request-ledger
CHATGPT_WEB_AGENT_REQUEST_LEDGER_RETENTION_DAYS=7
CHATGPT_WEB_AGENT_REQUEST_LEDGER_MAX_BYTES=67108864

# Full local request/response trace. Preserves ordinary tool payloads and outputs;
# only credentials and large binary/base64 blobs are omitted. Inactive days are
# zstd-compressed automatically.
CHATGPT_WEB_AGENT_FULL_TRACE_ENABLED=true
# CHATGPT_WEB_AGENT_FULL_TRACE_DIR=/absolute/path/to/full-trace
CHATGPT_WEB_AGENT_FULL_TRACE_RETENTION_DAYS=7
CHATGPT_WEB_AGENT_FULL_TRACE_MAX_BYTES=2147483648

# Read-only OpenClaw Skill discovery/read tools. Enabled by default.
# When enabled, MCP additionally exposes: skills_list, skill_read
CHATGPT_WEB_AGENT_SKILLS_ENABLED=true

# Minimal OpenClaw scope used for live eligibility/model-visibility checks.
# CHATGPT_WEB_AGENT_SKILLS_AGENT_ID=chatgpt-web-agent
# CHATGPT_WEB_AGENT_SKILLS_GATEWAY_URL=ws://127.0.0.1:18789

# Runtime-generated discovery metadata. Defaults to <workspace>/skills-catalog.
# CHATGPT_WEB_AGENT_SKILLS_CATALOG_DIR=/absolute/path/to/skills-catalog

# Optional semantic discovery accelerator. If unset/unavailable, skills_list(query=...)
# safely falls back to the live names-only catalog.
# CHATGPT_WEB_AGENT_SKILLS_QMD_URL=http://192.168.0.96:8182/mcp
# CHATGPT_WEB_AGENT_SKILLS_QMD_COLLECTION=skills-chatgpt-web-agent
# CHATGPT_WEB_AGENT_SKILLS_DEFAULT_LIMIT=8
# CHATGPT_WEB_AGENT_SKILLS_MAX_LIMIT=20
# CHATGPT_WEB_AGENT_SKILLS_TIMEOUT_MS=10000
# CHATGPT_WEB_AGENT_SKILLS_MAX_FILE_BYTES=256000

# Optional Google Drive data-plane tools. Disabled until local OAuth is configured.
# When enabled, MCP additionally exposes:
# drive_list, drive_search, drive_stat, drive_upload, drive_download, drive_export, drive_mkdir
CHATGPT_WEB_AGENT_DRIVE_ENABLED=false

# Google Desktop OAuth client JSON downloaded from Google Cloud Console.
# Defaults to <workspace>/.credentials/google-drive/credentials.json
# CHATGPT_WEB_AGENT_DRIVE_CREDENTIALS=/absolute/path/to/credentials.json

# Authorized-user token generated by `pnpm drive:auth`.
# Defaults to <workspace>/.credentials/google-drive/token.json
# CHATGPT_WEB_AGENT_DRIVE_TOKEN=/absolute/path/to/token.json

# Local staging directory used by Drive upload/download/export.
# Defaults to <workspace>/exchange
# CHATGPT_WEB_AGENT_DRIVE_LOCAL_ROOT=/absolute/path/to/exchange

# Keep Drive file transfer paths inside the staging directory. Defaults to true.
# CHATGPT_WEB_AGENT_DRIVE_LOCAL_ROOT_ONLY=true

# Optional narrow Feishu outbound bridge. Disabled until a dedicated OpenClaw
# Feishu account is configured for this Web Agent.
# When enabled, MCP additionally exposes: feishu_message, feishu_directory
CHATGPT_WEB_AGENT_FEISHU_ENABLED=false

# Sender identity is deployment configuration, not a tool argument. Keep these
# fixed to the dedicated Web Agent identity to avoid sending as another bot.
# CHATGPT_WEB_AGENT_FEISHU_AGENT_ID=chatgpt-web-agent
# CHATGPT_WEB_AGENT_FEISHU_ACCOUNT_ID=chatgpt-web-agent
# CHATGPT_WEB_AGENT_FEISHU_GATEWAY_URL=ws://127.0.0.1:18789
# CHATGPT_WEB_AGENT_FEISHU_TIMEOUT_MS=10000

# Local files sent through feishu_message(mediaPath=...) are restricted to this
# root by default. Relative paths resolve from here. Defaults to the workspace.
# OpenClaw's agent-scoped outbound media policy still applies as a second guard.
# CHATGPT_WEB_AGENT_FEISHU_MEDIA_ROOT=/absolute/path/to/workspace
# CHATGPT_WEB_AGENT_FEISHU_MEDIA_ROOT_ONLY=true

# Feishu group/user/member discovery result bounds.
# CHATGPT_WEB_AGENT_FEISHU_DIRECTORY_DEFAULT_LIMIT=20
# CHATGPT_WEB_AGENT_FEISHU_DIRECTORY_MAX_LIMIT=100
